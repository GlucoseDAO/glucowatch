<?xml version="1.0" encoding="utf-8"?>
<!--
  GlucoWatch face (Watch Face Format v1, 450x450 design canvas, laid out for a round screen).
  All glucose data comes from the GlucoWatch app through complications:
    slot 0  value + trend      (GlucoseValueComplicationService, SHORT_TEXT)
    slot 1  glucose chart      (GlucoseChartComplicationService, SMALL_IMAGE or PHOTO_IMAGE)
    slot 2  optional forecast  (PredictionComplicationService, empty unless enabled in the app)
    slot 3  IOB / COB          (LoopComplicationService, Nightscout with a loop only)
    slot 4  last bolus / carbs (TreatmentComplicationService, Nightscout only)
  Slots 3 and 4 stay empty with Dexcom Share; demo data fills both.
  Every slot can be re-assigned to any other data source from the watch face editor.
  Keep the ComplicationSlot elements in slotId order: the Wear runtime keeps a user's providers
  by the position of the slot in this file, so reordering them swaps providers on update.
  Colours match the app: insulin #60A5FA, carbs #FB923C, forecast #C4B5FD.
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <Scene backgroundColor="#FF000000">

        <DigitalClock x="0" y="40" width="450" height="74">
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="450" height="74">
                <Font family="SYNC_TO_DEVICE" size="64" weight="NORMAL" color="#FFD1D5DB" />
            </TimeText>
        </DigitalClock>

        <ComplicationSlot slotId="0" displayName="Glucose" x="107" y="114" width="236" height="112"
            supportedTypes="SHORT_TEXT RANGED_VALUE" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="io.github.antonkulaga.glucowatch/io.github.antonkulaga.glucowatch.complications.GlucoseValueComplicationService"
                primaryProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="236" height="112" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="236" height="84">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="78" weight="BOLD" color="#FFFFFFFF">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="82" width="236" height="30">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="24" color="#FF9CA3AF">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartText x="0" y="0" width="236" height="84">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="78" weight="BOLD" color="#FFFFFFFF">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="82" width="236" height="30">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="24" color="#FF9CA3AF">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="1" displayName="Chart" x="57" y="230" width="336" height="140"
            supportedTypes="SMALL_IMAGE PHOTO_IMAGE" isCustomizable="TRUE">
            <!-- Wear OS does not accept PHOTO_IMAGE as a default type, so the default is a photo-style SMALL_IMAGE. -->
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE"
                primaryProvider="io.github.antonkulaga.glucowatch/io.github.antonkulaga.glucowatch.complications.GlucoseChartComplicationService"
                primaryProviderType="SMALL_IMAGE" />
            <BoundingBox x="0" y="0" width="336" height="140" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="336" height="140">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <PartImage x="0" y="0" width="336" height="140">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Image resource="[COMPLICATION.PHOTO_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="2" displayName="Forecast" x="125" y="374" width="200" height="44"
            supportedTypes="SHORT_TEXT" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="io.github.antonkulaga.glucowatch/io.github.antonkulaga.glucowatch.complications.PredictionComplicationService"
                primaryProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="200" height="44" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="200" height="44">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="26" weight="MEDIUM" color="#FFC4B5FD">
                            <Template>%s in %s<Parameter expression="[COMPLICATION.TEXT]" /><Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="3" displayName="Insulin and carbs" x="20" y="126" width="88" height="76"
            supportedTypes="SHORT_TEXT" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="io.github.antonkulaga.glucowatch/io.github.antonkulaga.glucowatch.complications.LoopComplicationService"
                primaryProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="88" height="76" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="4" width="88" height="40">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="30" weight="MEDIUM" color="#FF60A5FA">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="44" width="88" height="28">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="24" weight="MEDIUM" color="#FFFB923C">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="4" displayName="Last bolus" x="342" y="126" width="88" height="76"
            supportedTypes="SHORT_TEXT" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="io.github.antonkulaga.glucowatch/io.github.antonkulaga.glucowatch.complications.TreatmentComplicationService"
                primaryProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="88" height="76" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="4" width="88" height="40">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="30" weight="MEDIUM" color="#FFE5E7EB">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="44" width="88" height="28">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="22" color="#FF9CA3AF">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>
    </Scene>
</WatchFace>
