<?xml version="1.0" encoding="utf-8"?>
<!--
  GlucoWatch face (Watch Face Format v1, 450x450 design canvas, laid out for a round screen).
  Back to front: a light gray in-range tint, then the type, then a thin glucose line.
  The hour and minute are translucent white Modak digits, stacked in the middle of the face.
  The forecast words sit between that pair and the battery. Date, heart rate and battery sit on the rim.
  All glucose data comes from the GlucoWatch app through complications:
    slot 0  value + trend      (GlucoseValueComplicationService, SMALL_IMAGE)
    slot 1  glucose chart      (GlucoseChartComplicationService, SMALL_IMAGE or PHOTO_IMAGE)
    slot 2  optional forecast  (PredictionComplicationService, empty unless enabled in the app)
    slot 3  IOB / COB          (LoopComplicationService, Nightscout with a loop only)
    slot 4  last bolus / carbs (TreatmentComplicationService, Nightscout only)
  Slots 3 and 4 stay empty with Dexcom Share; demo data fills both.
  Every slot can be re-assigned to any other data source from the watch face editor.
  Keep the ComplicationSlot elements in slotId order: the Wear runtime keeps a user's providers
  by the position of the slot in this file, so reordering them swaps providers on update.
  The glucose image and chart share the tile's green/yellow/red state palette. The value image
  becomes gray with an OLD DATA warning when its reading is more than 10 minutes old.
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <Scene backgroundColor="#FF000000">

        <!-- Wash behind the type, and the reading on the left of the middle band. -->
        <ComplicationSlot slotId="0" displayName="Glucose" x="0" y="0" width="450" height="450"
            supportedTypes="SMALL_IMAGE SHORT_TEXT RANGED_VALUE" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE"
                primaryProvider="io.github.antonkulaga.glucowatch/io.github.antonkulaga.glucowatch.complications.GlucoseValueComplicationService"
                primaryProviderType="SMALL_IMAGE" />
            <BoundingBox x="0" y="0" width="450" height="450" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="190" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="150" height="64">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="baloo2" size="34" weight="EXTRA_BOLD" color="#FFFFFFFF">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="64" width="150" height="28">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="13" color="#FF9AA3A8">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartText x="0" y="0" width="150" height="64">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="baloo2" size="34" weight="EXTRA_BOLD" color="#FFFFFFFF">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="64" width="150" height="28">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" color="#FF9AA3A8">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <!-- Hour over minute, translucent, centered on the face. -->
        <PartText x="98" y="78" width="310" height="156" pivotX="0.5" pivotY="1" scaleX="1" scaleY="0.92" alpha="160">
            <Variant mode="AMBIENT" target="alpha" value="100" />
            <Text align="CENTER">
                <Font family="modak" size="160" weight="NORMAL" color="#FFFFFFFF">
                    <Template>%02d<Parameter expression="[HOUR_0_23]" /></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="98" y="190" width="310" height="156" pivotX="0.5" pivotY="0" scaleX="1" scaleY="0.92" alpha="160">
            <Variant mode="AMBIENT" target="alpha" value="100" />
            <Text align="CENTER">
                <Font family="modak" size="160" weight="NORMAL" color="#FFFFFFFF">
                    <Template>%02d<Parameter expression="[MINUTE]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- 2 o'clock, rotated so dd.MM follows the rim. -->
        <PartText x="338" y="96" width="100" height="32" pivotX="0.5" pivotY="0.5" angle="52">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#FFFFFFFF">
                    <Template><![CDATA[%02d.%02d]]><Parameter expression="[DAY]" /><Parameter expression="[MONTH]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- 10 o'clock, rotated so the heart rate follows the rim. A missing sensor is a dash. -->
        <Group name="heart" x="8" y="96" width="100" height="32" pivotX="0.5" pivotY="0.5" angle="-52">
            <PartText x="0" y="0" width="28" height="32">
                <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="22" color="#FFF0525A"><Template>♥</Template></Font></Text>
            </PartText>
            <Condition>
                <Expressions>
                    <Expression name="hasHeartRate"><![CDATA[[HEART_RATE] > 0]]></Expression>
                </Expressions>
                <Compare expression="hasHeartRate">
                    <PartText x="28" y="0" width="72" height="32">
                        <Text align="START" ellipsis="TRUE">
                            <Font family="SYNC_TO_DEVICE" size="22" weight="MEDIUM" color="#FFF0525A">
                                <Template>%d<Parameter expression="round([HEART_RATE])" /></Template>
                            </Font>
                        </Text>
                    </PartText>
                </Compare>
                <Default>
                    <PartText x="28" y="0" width="72" height="32">
                        <Text align="START"><Font family="SYNC_TO_DEVICE" size="22" color="#FFF0525A"><Template>--</Template></Font></Text>
                    </PartText>
                </Default>
            </Condition>
        </Group>

        <!-- 6 o'clock, on the rim. Upright so the percent stays readable. -->
        <Group name="battery" x="145" y="404" width="160" height="32">
            <PartDraw x="0" y="4" width="28" height="22">
                <RoundRectangle x="0" y="3" width="20" height="14" cornerRadiusX="2" cornerRadiusY="2">
                    <Stroke color="#FFFFFFFF" thickness="2" />
                </RoundRectangle>
                <Rectangle x="21" y="7" width="3" height="6">
                    <Fill color="#FFFFFFFF" />
                </Rectangle>
            </PartDraw>
            <PartText x="32" y="0" width="120" height="32">
                <Text align="START" ellipsis="TRUE">
                    <Font family="SYNC_TO_DEVICE" size="22" weight="MEDIUM" color="#FFFFFFFF">
                        <Template>%d%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- The line and the forecast, painted last so they cross the type. -->
        <ComplicationSlot slotId="1" displayName="Chart" x="0" y="0" width="450" height="450"
            supportedTypes="SMALL_IMAGE PHOTO_IMAGE" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE"
                primaryProvider="io.github.antonkulaga.glucowatch/io.github.antonkulaga.glucowatch.complications.GlucoseChartComplicationService"
                primaryProviderType="SMALL_IMAGE" />
            <BoundingBox x="0" y="0" width="450" height="450" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="160" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <PartImage x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="160" />
                    <Image resource="[COMPLICATION.PHOTO_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <!-- Optional slots stay in their original XML order and remain editable. Their defaults
             are empty to keep the new face as quiet as the Glucose-all tile. -->
        <ComplicationSlot slotId="2" displayName="Forecast" x="165" y="372" width="120" height="28"
            supportedTypes="SHORT_TEXT" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="120" height="28" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="120" height="28">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="MEDIUM" color="#FF9AA3A8">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="3" displayName="Insulin and carbs" x="20" y="372" width="96" height="28"
            supportedTypes="SHORT_TEXT" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="96" height="28" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="96" height="28">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="MEDIUM" color="#FF9AA3A8">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="4" displayName="Last bolus" x="334" y="372" width="96" height="28"
            supportedTypes="SHORT_TEXT" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="96" height="28" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="96" height="28">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="MEDIUM" color="#FF9AA3A8">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>
    </Scene>
</WatchFace>
