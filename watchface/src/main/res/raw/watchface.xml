<?xml version="1.0" encoding="utf-8"?>
<!--
  GlucoWatch face (Watch Face Format v1, 450x450 design canvas, laid out for a round screen).
  The default layout follows the Glucose-all tile: time, a state-coloured glucose value and
  trend, a rim-to-rim range chart, then heart rate and battery.
  All glucose data comes from the GlucoWatch app through complications:
    slot 0  value + trend      (GlucoseValueComplicationService, SMALL_IMAGE)
    slot 1  glucose chart      (GlucoseChartComplicationService, SMALL_IMAGE or PHOTO_IMAGE)
    slot 2  optional forecast  (PredictionComplicationService, empty unless enabled in the app)
    slot 3  IOB / COB          (LoopComplicationService, Nightscout with a loop only)
    slot 4  last bolus / carbs (TreatmentComplicationService, Nightscout only)
  Slots 3 and 4 stay empty with Dexcom Share; demo data fills both.
  Every slot can be re-assigned to any other data source from the watch face editor.
  Keep the ComplicationSlot elements in slotId order: the Wear runtime keeps a user's providers
  by the position of the slot in this file, so reordering them swaps providers on update.
  The glucose image and chart share the tile's green/yellow/red state palette. The value image
  becomes gray with an OLD DATA warning when its reading is more than 10 minutes old.
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <Scene backgroundColor="#FF000000">

        <DigitalClock x="0" y="51" width="450" height="65">
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="450" height="65">
                <Font family="SYNC_TO_DEVICE" size="52" weight="BOLD" color="#FFFFFFFF" />
            </TimeText>
        </DigitalClock>

        <ComplicationSlot slotId="0" displayName="Glucose" x="45" y="112" width="360" height="132"
            supportedTypes="SMALL_IMAGE SHORT_TEXT RANGED_VALUE" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE"
                primaryProvider="io.github.antonkulaga.glucowatch/io.github.antonkulaga.glucowatch.complications.GlucoseValueComplicationService"
                primaryProviderType="SMALL_IMAGE" />
            <BoundingBox x="0" y="0" width="360" height="132" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="360" height="132">
                    <Variant mode="AMBIENT" target="alpha" value="190" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="360" height="98">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="88" weight="BOLD" color="#FFFFFFFF">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="100" width="360" height="32">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="23" color="#FF9AA3A8">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="RANGED_VALUE">
                <PartText x="0" y="0" width="360" height="98">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="88" weight="BOLD" color="#FFFFFFFF">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="100" width="360" height="32">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="23" color="#FF9AA3A8">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="1" displayName="Chart" x="0" y="180" width="450" height="200"
            supportedTypes="SMALL_IMAGE PHOTO_IMAGE" isCustomizable="TRUE">
            <!-- Wear OS does not accept PHOTO_IMAGE as a default type, so the default is a photo-style SMALL_IMAGE. -->
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SMALL_IMAGE"
                primaryProvider="io.github.antonkulaga.glucowatch/io.github.antonkulaga.glucowatch.complications.GlucoseChartComplicationService"
                primaryProviderType="SMALL_IMAGE" />
            <BoundingBox x="0" y="0" width="450" height="200" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="450" height="200">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="PHOTO_IMAGE">
                <PartImage x="0" y="0" width="450" height="200">
                    <Variant mode="AMBIENT" target="alpha" value="140" />
                    <Image resource="[COMPLICATION.PHOTO_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <!-- The bottom row follows the tile. Heart rate comes from the watch; a missing sensor
             reading is shown as a dash instead of a misleading zero. -->
        <Group name="heart_and_battery" x="105" y="386" width="240" height="38">
            <PartText x="0" y="0" width="35" height="38">
                <Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="27" color="#FFF0525A"><Template>♥</Template></Font></Text>
            </PartText>
            <Condition>
                <Expressions>
                    <Expression name="hasHeartRate"><![CDATA[[HEART_RATE] > 0]]></Expression>
                </Expressions>
                <Compare expression="hasHeartRate">
                    <PartText x="36" y="0" width="59" height="38">
                        <Text align="START" ellipsis="TRUE">
                            <Font family="SYNC_TO_DEVICE" size="27" weight="MEDIUM" color="#FFF0525A">
                                <Template>%d<Parameter expression="round([HEART_RATE])" /></Template>
                            </Font>
                        </Text>
                    </PartText>
                </Compare>
                <Default>
                    <PartText x="36" y="0" width="59" height="38">
                        <Text align="START"><Font family="SYNC_TO_DEVICE" size="27" color="#FFF0525A"><Template>--</Template></Font></Text>
                    </PartText>
                </Default>
            </Condition>
            <PartDraw x="117" y="8" width="32" height="24">
                <RoundRectangle x="0" y="3" width="25" height="17" cornerRadiusX="2" cornerRadiusY="2">
                    <Stroke color="#FFFFFFFF" thickness="2" />
                </RoundRectangle>
                <Rectangle x="26" y="8" width="3" height="7">
                    <Fill color="#FFFFFFFF" />
                </Rectangle>
            </PartDraw>
            <PartText x="151" y="0" width="89" height="38">
                <Text align="START" ellipsis="TRUE">
                    <Font family="SYNC_TO_DEVICE" size="27" weight="MEDIUM" color="#FFFFFFFF">
                        <Template>%d%%<Parameter expression="[BATTERY_PERCENT]" /></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- Optional slots stay in their original XML order and remain editable. Their defaults
             are empty to keep the new face as quiet as the Glucose-all tile. -->
        <ComplicationSlot slotId="2" displayName="Forecast" x="165" y="15" width="120" height="30"
            supportedTypes="SHORT_TEXT" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="120" height="30" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="120" height="30">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="MEDIUM" color="#FF9AA3A8">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="3" displayName="Insulin and carbs" x="59" y="19" width="96" height="30"
            supportedTypes="SHORT_TEXT" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="96" height="30" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="96" height="30">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="MEDIUM" color="#FF9AA3A8">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="4" displayName="Last bolus" x="295" y="19" width="96" height="30"
            supportedTypes="SHORT_TEXT" isCustomizable="TRUE">
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingBox x="0" y="0" width="96" height="30" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="96" height="30">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" weight="MEDIUM" color="#FF9AA3A8">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>
    </Scene>
</WatchFace>
