# Developer defaults. Copy to .env (git-ignored, never commit it) and fill in:
#   cp .env.example .env
#
# Used by:
#   - ./gradlew :core:run        desktop Share or Nightscout check, no prompts
#   - DEBUG builds of the app    compiled in as initial settings, so a fresh install is logged in
#   - scripts/screenshots.py     which scenarios it can capture (docs/screenshots.md)
# Release builds never contain these values. Environment variables with the same names win.
# Values are taken literally (no escape sequences). Quote a value that contains spaces or " #":
#   DEXCOM_PASSWORD="my pass #1"     or, if it contains double quotes:  DEXCOM_PASSWORD='my"pass'
# After editing, rebuild and reinstall the debug APK; changed values are applied on next start.

# Same login as the Dexcom (main) app
DEXCOM_USERNAME=
DEXCOM_PASSWORD=

# Share server: eu (= outside US), us or jp
DEXCOM_REGION=eu

# Nightscout: the site's address, and an access token with the readable role
# (Admin tools → Subjects). Leave the token empty for a public site. API: v1 or v3 (v3 needs a token).
NIGHTSCOUT_URL=
NIGHTSCOUT_TOKEN=
NIGHTSCOUT_API=v1

# Which source a fresh debug install uses: demo, share or nightscout.
# Empty: share when the Dexcom login is set, otherwise nightscout when NIGHTSCOUT_URL is set.
GLUCOWATCH_SOURCE=

# mmol or mgdl
GLUCOWATCH_UNIT=mmol

# Show the forecast line and slot by default: true or false
GLUCOWATCH_PREDICTION=false
